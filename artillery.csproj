<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 某些 NuGet 包在 Godot 下需要本地程序集拷贝才能被运行时加载 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 集成测试只在 Debug/ExportDebug 下参与编译；Release/ExportRelease 排除，避免随游戏发布 -->
  <PropertyGroup Condition="('$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug')">
    <RunTests>true</RunTests>
    <DefineConstants>$(DefineConstants);RUN_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主工程位于仓库根目录，默认 **/*.cs 通配会吞掉嵌套的 xUnit 测试工程源码；显式排除 -->
    <Compile Remove="artillery.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' == 'true'">
    <!-- 测试依赖：GoDotTest 是执行器，GodotTestDriver 提供 node 驱动/fixture，Shouldly 是断言库 -->
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.46" />
    <PackageReference Include="Chickensoft.GodotTestDriver" Version="3.1.81" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' != 'true'">
    <Compile Remove="test/**/*.cs" />
    <None Remove="test/**/*" />
    <EmbeddedResource Remove="test/**/*" />
  </ItemGroup>
</Project>
